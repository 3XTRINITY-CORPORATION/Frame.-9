# Copy to .env and fill in locally. Never commit .env.
PORT=
OPENAI_API_KEY=
XAI_API_KEY=

# Required for every /ai/* route: callers send "Authorization: Bearer <token>".
# If unset, /ai/* fails closed with 503.
FRAME9_SERVICE_TOKEN=
# Optional: max /ai/* requests per IP per minute (default 30).
AI_RATE_LIMIT_MAX=
